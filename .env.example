# Alpaca API Credentials
ALPACA_API_KEY_ID=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Set to 'paper' for paper trading / testing, or 'live' for real money execution
ALPACA_ENV=paper

# Initial cash for the simulated broker (used for dry runs and hybrid fallback trading)
SIMULATOR_INITIAL_CASH=10000.0

# Strategy Configuration
DEFAULT_TRADING_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA

# Dynamic Scanner (scrapes S&P 500 from Wikipedia + cryptos; overrides DEFAULT_TRADING_SYMBOLS if True)
DYNAMIC_SCAN=False
DYNAMIC_STOCK_LIMIT=-1

# Strategy Signal Thresholds (Set close to 0, e.g., 0.01 and -0.01, to easily force trades for testing)
BUY_THRESHOLD=0.25
SELL_THRESHOLD=-0.25

# Maximum fraction of portfolio value allocated to a single trade (e.g., 0.10 = 10%)
MAX_POSITION_SIZE_PCT=0.10
# Daily loss limit as a fraction of portfolio (e.g., 0.02 = 2% loss limit)
DAILY_LOSS_LIMIT_PCT=0.02

# Refresh intervals
PORTFOLIO_REFRESH_SECS=15
REANALYZE_INTERVAL_MINS=60

# Resource optimization limits (to prevent VM freezes)
# Delay in seconds between analyzing each symbol in the loop
ANALYSIS_THROTTLE_DELAY_SECS=1.5
# Expiration duration in hours for caching fundamentals (yfinance info calls)
FUNDAMENTALS_CACHE_EXPIRE_HOURS=24
# Expiration duration in hours for caching news sentiment (Gemini API calls)
SENTIMENT_CACHE_EXPIRE_HOURS=2

# LLM API Config (if using LLM for news sentiment analysis)
# GEMINI_API_KEY=your_gemini_api_key_here

# Web server configuration
FLASK_DEBUG=False
AUTO_START_BOT=True

# Allow unlimited dynamic symbol scanning (scrapes ~540 assets; can cause high resource usage)
ALLOW_UNLIMITED_SCAN=True
