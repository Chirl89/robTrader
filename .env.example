# Alpaca API Credentials
ALPACA_API_KEY_ID=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Set to 'paper' for paper trading / testing, or 'live' for real money execution
ALPACA_ENV=paper

# Strategy Configuration
DEFAULT_TRADING_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA

# Dynamic Scanner (scrapes S&P 500 from Wikipedia + cryptos; overrides DEFAULT_TRADING_SYMBOLS if True)
DYNAMIC_SCAN=False
DYNAMIC_STOCK_LIMIT=15

# Strategy Signal Thresholds (Set close to 0, e.g., 0.01 and -0.01, to easily force trades for testing)
BUY_THRESHOLD=0.25
SELL_THRESHOLD=-0.25

# Maximum fraction of portfolio value allocated to a single trade (e.g., 0.10 = 10%)
MAX_POSITION_SIZE_PCT=0.10
# Daily loss limit as a fraction of portfolio (e.g., 0.02 = 2% loss limit)
DAILY_LOSS_LIMIT_PCT=0.02

# Run frequency in minutes (e.g., 60 for hourly, 1440 for daily at market close)
RUN_FREQUENCY_MINS=60

# LLM API Config (if using LLM for news sentiment analysis)
# GEMINI_API_KEY=your_gemini_api_key_here
